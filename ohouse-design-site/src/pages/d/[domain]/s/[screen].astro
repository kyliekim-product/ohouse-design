---
import Layout from '../../../../layouts/Layout.astro';
import {
  CATEGORIES,
  getAllDomains,
  getDomain,
  getDomainScreens,
  getScreen,
  getScreenComponentUsage,
  buildPrompt,
  relTime,
} from '../../../../lib/repo.js';

export async function getStaticPaths() {
  const all = getAllDomains();
  const paths = [];
  for (const d of all) {
    const screens = getDomainScreens(d.slug);
    for (const s of screens) {
      paths.push({ params: { domain: d.slug, screen: s.slug } });
    }
  }
  return paths;
}

const base = import.meta.env.BASE_URL;
const { domain: dSlug, screen: sSlug } = Astro.params;
const domain = getDomain(dSlug);
const screen = getScreen(dSlug, sSlug);
if (!domain || !screen) return Astro.redirect(`${base}d/${dSlug}`);

const prompt = buildPrompt({ kind: 'screen', domain: dSlug, screen: sSlug, markers: screen.markers });
const componentUsage = getScreenComponentUsage(dSlug, sSlug);
const categoryLabel = Object.entries(CATEGORIES).find(([, slugs]) => slugs.includes(dSlug))?.[0] || null;
const statusLabel = screen.status
  ? String(screen.status).split('-').map((word) => word.charAt(0).toUpperCase() + word.slice(1)).join(' ')
  : null;
const foundInItems = [
  categoryLabel,
  domain.label,
  statusLabel,
  screen.variant,
  screen.markers.length > 0 ? `+${screen.markers.length} markers` : null,
].filter(Boolean);
---

<Layout title={`${screen.label} · ${domain.label}`}>
  <section class="screen-detail">
    <div class="screen-detail__main wrap">
      <aside class="screen-detail__preview">
        <div class="shead__thumb">
          {screen.previewHtml ? (
            <iframe
              class="shead__frame"
              srcdoc={screen.previewHtml}
              sandbox=""
              loading="lazy"
              title={`${screen.label} 프로토타입 미리보기`}
            />
          ) : screen.thumb ? (
            <button
              type="button"
              class="shead__thumb-trigger"
              data-lightbox-src={screen.thumb}
              data-lightbox-caption={`${domain.label} · ${screen.label}`}
              aria-label={`${screen.label} 이미지 확대 보기`}
            >
              <img src={screen.thumb} alt={screen.label} />
              <span class="shead__zoom" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="11" cy="11" r="7"/><line x1="21" y1="21" x2="16.65" y2="16.65"/><line x1="11" y1="8" x2="11" y2="14"/><line x1="8" y1="11" x2="14" y2="11"/>
                </svg>
                확대
              </span>
            </button>
          ) : (
            <div class="shead__placeholder">
              <span>{screen.label}</span>
              <span class="shead__placeholder-hint">prototype.html / thumbnail 미준비</span>
            </div>
          )}
          {screen.prototypeUrl && (
            <iframe
              class="shead__live"
              data-live-frame
              data-src={screen.prototypeUrl}
              sandbox="allow-scripts allow-same-origin"
              title={`${screen.label} live 프로토타입`}
              hidden
            />
          )}
        </div>
        {screen.prototypeUrl && (
          <div class="preview-live-controls">
            <button type="button" class="btn-secondary" data-live-toggle aria-pressed="false">
              ▶ Live 프리뷰 보기
            </button>
            <a class="btn-secondary btn-secondary--stroke" href={screen.prototypeUrl} target="_blank" rel="noopener">
              ↗ 새 탭에서 열기
            </a>
          </div>
        )}
      </aside>

      <main class="screen-detail__scroll">
        <section class="shead">
        <div class="shead__info">
          <h1>{screen.label}</h1>
          {screen.updated && (
            <p class="shead__time">Last updated · {relTime(screen.updated)}</p>
          )}

          <div class="screen-found" aria-label="screen metadata">
            <span class="screen-found__label">Found in</span>
            <div class="screen-found__chips">
              {foundInItems.map((item) => (
                <span class="screen-found__chip">{item}</span>
              ))}
            </div>
          </div>

          <div class="shead__actions">
            <button type="button" class="btn-primary" data-copy-prompt={prompt}>
              ⟳ Copy prompt
            </button>
            <button type="button" class="btn-secondary btn-secondary--stroke" data-prompt-preview-open aria-controls="prompt-preview-modal">
              Preview
            </button>
            {screen.prototype && (
              <a class="btn-secondary" href={`https://github.com/bucketplace/product-design/blob/main/${screen.prototype}`} target="_blank" rel="noopener">
                Prototype source ↗
              </a>
            )}
          </div>

          {screen.markers.length > 0 && (
            <div class="shead__markers">
              <div class="shead__markers-label">사용 컴포넌트 · 마커</div>
              <div class="shead__markers-list">
                {screen.markers.map((m) => (
                  <span class={`badge${m.kind === 'missing-ods' ? ' badge--warn' : m.kind === 'ods-component' ? ' badge--accent' : ''}`}>
                    @{m.kind}:{m.value}
                  </span>
                ))}
              </div>
            </div>
          )}
        </div>
        </section>

        <section class="screen-usage">
          <div class="screen-usage__main">
            <div class="screen-usage__content">
              <nav class="screen-info-tabs dtabs" aria-label="screen info tabs" id="screen-info-tabs">
                <div class="dtabs__inner">
                  {screen.prototypeMetaHtml && (
                    <a class="dtab is-active" href={`${base}d/${dSlug}/s/${sSlug}?info=screen-info`} data-screen-info-tab="screen-info">
                      Screen Info
                    </a>
                  )}
                  <a class={`dtab${screen.prototypeMetaHtml ? '' : ' is-active'}`} href={`${base}d/${dSlug}/s/${sSlug}?info=ods`} data-screen-info-tab="ods">
                    ODS Components <span class="dtab__count">{componentUsage.ods.length}</span>
                  </a>
                  <a class="dtab" href={`${base}d/${dSlug}/s/${sSlug}?info=domain`} data-screen-info-tab="domain">
                    Domain / Track Components <span class="dtab__count">{componentUsage.domain.length}</span>
                  </a>
                </div>
              </nav>

              <div class="screen-info-body">
                {screen.prototypeMetaHtml && (
                  <div class="screen-info-panel" data-screen-info-panel="screen-info">
                    {screen.prototypeUrl && (
                      <div class="stage-live-row" aria-label="단계별 라이브">
                        <span class="stage-live-row__label">단계별 라이브</span>
                        {[['1', '1차'], ['2', '2차'], ['3a', '3a 초안'], ['3b', '3b 디벨롭']].map(([id, label]) => (
                          <button type="button" class="stage-live-link" data-stage-live={id}>{label}</button>
                        ))}
                      </div>
                    )}
                    <div class="screen-spec__body" set:html={screen.prototypeMetaHtml} />
                  </div>
                )}

                <div class="screen-info-panel" data-screen-info-panel="ods" hidden={!!screen.prototypeMetaHtml}>
                  {componentUsage.ods.length > 0 ? (
                    <div class="screen-component-list">
                      {componentUsage.ods.map((component) => (
                        <div class="screen-component-card">
                          <div class="screen-component-card__head">
                            <span>{component.label}</span>
                            <span class="badge badge--accent">ODS</span>
                          </div>
                          <p>linked_yaml_components</p>
                        </div>
                      ))}
                    </div>
                  ) : (
                    <div class="empty">
                      <div class="empty__title">ODS 컴포넌트가 없습니다</div>
                    </div>
                  )}
                </div>

                <div class="screen-info-panel" data-screen-info-panel="domain" hidden>
                  {componentUsage.domain.length > 0 ? (
                    <div class="screen-component-list">
                      {componentUsage.domain.map((component) => (
                        <div class="screen-component-card">
                          <div class="screen-component-card__head">
                            <span>{component.label}</span>
                            <span class="badge badge--accent">{component.ownerDomain}</span>
                          </div>
                          {component.summary && <p>{component.summary}</p>}
                          <div class="screen-component-card__meta">
                            <span>{component.type}</span>
                            {component.status && <span>{component.status}</span>}
                            {component.sourcePath && <span>{component.sourcePath}</span>}
                          </div>
                        </div>
                      ))}
                    </div>
                  ) : (
                    <div class="empty">
                      <div class="empty__title">Domain / Track 컴포넌트가 없습니다</div>
                    </div>
                  )}
                </div>
              </div>
            </div>
          </div>
        </section>
      </main>
    </div>
  </section>

  <div id="prompt-preview-modal" class="prompt-modal" role="dialog" aria-modal="true" aria-hidden="true" aria-labelledby="prompt-preview-title">
    <button type="button" class="prompt-modal__backdrop" data-prompt-preview-close aria-label="Prompt preview 닫기"></button>
    <div class="prompt-modal__sheet">
      <div class="prompt-modal__head">
        <div>
          <p class="prompt-modal__eyebrow">Copy prompt</p>
          <h2 id="prompt-preview-title">Prompt preview</h2>
        </div>
        <button type="button" class="prompt-modal__close" data-prompt-preview-close aria-label="닫기">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
          </svg>
        </button>
      </div>
      <pre class="prompt-box prompt-box--modal">{prompt}</pre>
    </div>
  </div>

  <script>
    function initScreenInfoTabs() {
      const tabsNav = document.getElementById('screen-info-tabs');
      if (!tabsNav || (tabsNav as HTMLElement).dataset.bound) return;
      (tabsNav as HTMLElement).dataset.bound = '1';

      const panels = Array.from(document.querySelectorAll<HTMLElement>('.screen-info-panel'));
      const links = Array.from(tabsNav.querySelectorAll<HTMLElement>('.dtab'));

      function activate(id: string) {
        links.forEach((l) => l.classList.toggle('is-active', l.dataset.screenInfoTab === id));
        panels.forEach((p) => { p.hidden = p.dataset.screenInfoPanel !== id; });
      }

      const fromUrl = new URLSearchParams(window.location.search).get('info');
      const valid = links.map((l) => l.dataset.screenInfoTab);
      const initial = (fromUrl && valid.includes(fromUrl)) ? fromUrl : (links[0]?.dataset.screenInfoTab || 'ods');
      activate(initial);

      tabsNav.addEventListener('click', (e) => {
        const link = (e.target as HTMLElement).closest('.dtab') as HTMLElement | null;
        if (!link) return;
        e.preventDefault();
        const id = link.dataset.screenInfoTab || 'ods';
        activate(id);
        const url = new URL(window.location.href);
        url.searchParams.set('info', id);
        window.history.replaceState({}, '', url);
      });
    }
    initScreenInfoTabs();
    document.addEventListener('astro:page-load', initScreenInfoTabs);

    function initPromptPreviewModal() {
      const modal = document.getElementById('prompt-preview-modal');
      const openButton = document.querySelector<HTMLElement>('[data-prompt-preview-open]');
      if (!modal || !openButton || modal.dataset.bound) return;
      modal.dataset.bound = '1';
      const closeButtons = Array.from(modal.querySelectorAll<HTMLElement>('[data-prompt-preview-close]'));

      function openModal() {
        modal.classList.add('is-open');
        modal.setAttribute('aria-hidden', 'false');
        document.body.style.overflow = 'hidden';
      }

      function closeModal() {
        modal.classList.remove('is-open');
        modal.setAttribute('aria-hidden', 'true');
        document.body.style.overflow = '';
        openButton.focus();
      }

      openButton.addEventListener('click', openModal);
      closeButtons.forEach((button) => button.addEventListener('click', closeModal));
      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape' && modal.classList.contains('is-open')) closeModal();
      });
    }
    initPromptPreviewModal();
    document.addEventListener('astro:page-load', initPromptPreviewModal);

    function initStageLiveLinks() {
      const frame = document.querySelector<HTMLIFrameElement>('[data-live-frame]');
      const base = frame?.getAttribute('data-src');
      if (!frame || !base) return;
      document.querySelectorAll<HTMLElement>('[data-stage-live]').forEach((btn) => {
        if (btn.dataset.bound) return;
        btn.dataset.bound = '1';
        btn.addEventListener('click', () => {
          const sep = base.includes('?') ? '&' : '?';
          frame.setAttribute('src', `${base}${sep}stage=${btn.dataset.stageLive}`);
          document.querySelectorAll('[data-stage-live]').forEach((b) => b.classList.toggle('is-active', b === btn));
          frame.removeAttribute('hidden');
          const thumb = frame.closest('.shead__thumb') as HTMLElement | null;
          if (thumb) thumb.style.position = 'relative';
          const toggle = document.querySelector('[data-live-toggle]');
          if (toggle) { toggle.setAttribute('aria-pressed', 'true'); toggle.textContent = '■ 정적 프리뷰로 돌아가기'; }
        });
      });
    }
    initStageLiveLinks();
    document.addEventListener('astro:page-load', initStageLiveLinks);
  </script>
</Layout>

<style>
  .screen-detail {
    height: calc(100vh - 64px);
    overflow: hidden;
  }
  .screen-detail__main {
    height: 100%;
    display: grid; grid-template-columns: 360px 1fr; gap: 48px;
    align-items: start;
  }
  .screen-detail__preview {
    height: 100%;
    min-width: 0;
    overflow: visible;
    padding: 48px 0 32px;
  }
  .screen-detail__scroll {
    height: 100%;
    min-width: 0;
    overflow-y: auto;
    overscroll-behavior: contain;
    padding: 48px 0 96px;
    scrollbar-gutter: stable;
  }
  .shead { padding: 0 0 48px; }
  .screen-found {
    margin-top: 10px;
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
    font-size: 13px;
    color: var(--c-text-muted);
  }
  .screen-found__label { color: var(--c-text-muted); }
  .screen-found__chips {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
  }
  .screen-found__chip {
    display: inline-flex;
    align-items: center;
    min-height: 28px;
    padding: 5px 10px;
    border-radius: 8px;
    background: var(--c-bg-elev);
    color: var(--c-text);
    font-size: 13px;
    font-weight: 600;
    line-height: 1.2;
  }

  .shead__thumb {
    position: relative;
    aspect-ratio: 9 / 16;
    background: var(--c-bg-elev);
    border-radius: var(--r-card);
    overflow: hidden;
    box-shadow: var(--sh-lg);
  }
  .shead__thumb-trigger {
    position: relative;
    display: block;
    width: 100%; height: 100%;
    padding: 0; border: 0;
    background: transparent;
    border-radius: var(--r-card);
    overflow: hidden;
    cursor: zoom-in;
  }
  .shead__thumb img { width: 100%; height: 100%; object-fit: cover; transition: transform .25s ease; }
  .shead__thumb-trigger:hover img { transform: scale(1.03); }
  .shead__zoom {
    position: absolute; bottom: 12px; right: 12px;
    display: inline-flex; align-items: center; gap: 4px;
    padding: 6px 10px;
    background: rgba(10,10,10,.78);
    color: #fff;
    border-radius: 999px;
    font-size: 11px; font-weight: 600;
    opacity: 0;
    transition: opacity .15s;
  }
  .shead__thumb-trigger:hover .shead__zoom,
  .shead__thumb-trigger:focus-visible .shead__zoom { opacity: 1; }
  .shead__placeholder {
    width: 100%; height: 100%;
    display: flex; flex-direction: column; align-items: center; justify-content: center;
    gap: 8px; padding: 24px; text-align: center;
    color: var(--c-text-soft);
    background: var(--c-bg-elev);
  }
  .shead__placeholder span:first-child { font-size: 18px; font-weight: 600; color: var(--c-text-muted); }
  .shead__placeholder-hint { font-size: 11px; }
  .shead__frame {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
    background: #fff;
  }
  .shead__live {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
    background: #fff;
    z-index: 2;
  }
  .shead__live[hidden] {
    display: none;
  }
  .preview-live-controls {
    display: flex;
    gap: 8px;
    margin-top: 12px;
    flex-wrap: wrap;
  }

  .screen-info-tabs { margin-top: 8px; }
  .screen-info-body { padding-top: 32px; }
  .screen-info-panel[hidden] { display: none; }
  .screen-info-panel .screen-spec__body { margin-top: 0; }
  .screen-spec__body { margin-top: 16px; font-size: 14px; line-height: 1.7; color: var(--c-text-muted); }
  .screen-spec__body :global(h1) { font-size: 18px; font-weight: 700; color: var(--c-text); margin: 0 0 8px; letter-spacing: -0.01em; }
  .screen-spec__body :global(h3) { font-size: 14px; font-weight: 600; color: var(--c-text); margin: 20px 0 6px; }
  .screen-spec__body :global(blockquote) { margin: 8px 0 16px; padding-left: 12px; border-left: 3px solid var(--c-border); color: var(--c-text-soft); }
  .screen-spec__body :global(table) { width: 100%; border-collapse: collapse; margin: 12px 0; font-size: 13px; }
  .screen-spec__body :global(th), .screen-spec__body :global(td) { border: 1px solid var(--c-border); padding: 6px 10px; text-align: left; vertical-align: top; }
  .screen-spec__body :global(th) { background: var(--c-bg-soft); font-weight: 600; color: var(--c-text); }
  .screen-spec__body :global(ul) { margin: 6px 0; padding-left: 18px; }
  .screen-spec__body :global(li) { margin: 3px 0; }

  .shead__info h1 { font-size: 32px; font-weight: 700; letter-spacing: -0.02em; }
  .shead__time { margin-top: 6px; font-size: 13px; color: var(--c-text-soft); }

  .shead__actions { margin-top: 24px; display: flex; gap: 8px; flex-wrap: wrap; }
  .btn-primary {
    display: inline-flex; align-items: center; gap: 6px;
    background: var(--c-text); color: #fff;
    padding: 10px 18px; border-radius: 999px;
    font-size: 14px; font-weight: 600;
    transition: opacity .15s ease, transform .1s ease;
  }
  .btn-primary:hover { opacity: 0.85; color: #fff; }
  .btn-primary:active { transform: scale(0.98); }
  .btn-secondary {
    padding: 10px 18px; border-radius: 999px;
    border: 1px solid var(--c-border);
    font-size: 14px; font-weight: 500; color: var(--c-text);
    transition: background .15s;
  }
  .btn-secondary:hover { background: var(--c-bg-elev); }
  .btn-secondary--stroke { background: #fff; }

  .shead__markers { margin-top: 32px; }
  .shead__markers-label { font-size: 12px; font-weight: 500; color: var(--c-text-soft); margin-bottom: 10px; }
  .shead__markers-list { display: flex; flex-wrap: wrap; gap: 6px; }

  .prompt-box {
    background: var(--c-bg-elev);
    border-radius: var(--r-card);
    padding: 24px;
    font-size: 13px; line-height: 1.7;
    white-space: pre-wrap; word-break: break-word;
    color: var(--c-text);
    font-family: var(--f-mono);
  }
  .prompt-box--modal {
    max-height: min(58vh, 560px);
    overflow: auto;
  }
  .prompt-modal {
    position: fixed;
    inset: 0;
    z-index: 80;
    display: none;
    align-items: center;
    justify-content: center;
    padding: 24px;
  }
  .prompt-modal.is-open { display: flex; }
  .prompt-modal__backdrop {
    position: absolute;
    inset: 0;
    border: 0;
    background: rgba(0,0,0,.36);
  }
  .prompt-modal__sheet {
    position: relative;
    width: min(760px, 100%);
    max-height: calc(100vh - 48px);
    overflow: hidden;
    border-radius: 24px;
    background: #fff;
    box-shadow: 0 24px 80px rgba(0,0,0,.18);
    padding: 24px;
  }
  .prompt-modal__head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 16px;
  }
  .prompt-modal__eyebrow {
    font-size: 12px;
    font-weight: 650;
    color: var(--c-text-soft);
    margin-bottom: 6px;
  }
  .prompt-modal__head h2 {
    font-size: 20px;
    font-weight: 750;
    color: var(--c-text);
  }
  .prompt-modal__close {
    width: 36px;
    height: 36px;
    border: 1px solid var(--c-border);
    border-radius: 999px;
    background: #fff;
    color: var(--c-text);
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .screen-usage { padding: 0; }
  .screen-usage__main { min-width: 0; }
  .screen-usage__content { min-width: 0; }
  .screen-usage__tabs {
    position: static; top: auto; z-index: auto;
    margin-bottom: 0;
    background: transparent;
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
  }
  .screen-usage__tabs-inner { padding: 0; }
  .screen-usage__body { padding-top: 32px; }
  .screen-component-list { display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 12px; }
  .screen-component-card {
    padding: 16px; border-radius: 16px; background: var(--c-bg-elev);
    display: flex; flex-direction: column; gap: 8px;
  }
  .screen-component-card__head { display: flex; align-items: center; justify-content: space-between; gap: 10px; }
  .screen-component-card__head > span:first-child { font-size: 15px; font-weight: 700; color: var(--c-text); }
  .screen-component-card p { font-size: 13px; line-height: 1.55; color: var(--c-text-muted); }
  .screen-component-card__meta {
    display: flex; flex-wrap: wrap; gap: 8px;
    font-size: 11px; color: var(--c-text-soft); font-family: var(--f-mono);
  }
  @media (max-width: 720px) {
    .screen-detail {
      height: auto;
      overflow: visible;
    }
    .screen-detail__main {
      height: auto;
      grid-template-columns: 1fr;
      gap: 24px;
    }
    .screen-detail__preview {
      height: auto;
      overflow: visible;
      padding: 32px 0 0;
    }
    .screen-detail__scroll {
      height: auto;
      overflow: visible;
      overscroll-behavior: auto;
      padding: 0 0 72px;
    }
    .shead { padding: 0 0 40px; }
    .shead__thumb { position: static; top: auto; }
    .prompt-modal {
      align-items: flex-end;
      padding: 0;
    }
    .prompt-modal__sheet {
      width: 100%;
      max-height: 86vh;
      border-radius: 24px 24px 0 0;
      padding: 20px;
    }
    .prompt-box--modal { max-height: 58vh; }
  }

  .stage-live-row { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; margin-bottom: 20px; }
  .stage-live-row__label { font-size: 12px; font-weight: 600; color: var(--c-text-soft); margin-right: 4px; }
  .stage-live-link {
    border: 1px solid var(--c-border); background: var(--c-bg-elev); color: var(--c-text-muted);
    border-radius: 999px; padding: 6px 14px; font-size: 13px; font-weight: 600; cursor: pointer;
    transition: background .15s, color .15s;
  }
  .stage-live-link:hover { background: var(--c-bg-elev-2); color: var(--c-text); }
  .stage-live-link.is-active { background: var(--c-bg-elev-2); color: var(--c-text); border-color: var(--c-text); }
</style>

<script>
  document.querySelectorAll('[data-live-toggle]').forEach((btn) => {
    const aside = btn.closest('.screen-detail__preview');
    const frame = aside && aside.querySelector('[data-live-frame]');
    if (!frame) return;
    const thumb = frame.closest('.shead__thumb');
    btn.addEventListener('click', () => {
      const isHidden = frame.hasAttribute('hidden');
      if (isHidden) {
        if (frame.dataset.src && !frame.getAttribute('src')) {
          frame.setAttribute('src', frame.dataset.src);
        }
        frame.removeAttribute('hidden');
        if (thumb) thumb.style.position = 'relative';
        btn.setAttribute('aria-pressed', 'true');
        btn.textContent = '■ 정적 프리뷰로 돌아가기';
        document.querySelectorAll('[data-stage-live]').forEach((b) => b.classList.remove('is-active'));
      } else {
        frame.setAttribute('hidden', '');
        if (thumb) thumb.style.position = '';
        btn.setAttribute('aria-pressed', 'false');
        btn.textContent = '▶ Live 프리뷰 보기';
        frame.removeAttribute('src');
        document.querySelectorAll('[data-stage-live]').forEach((b) => b.classList.remove('is-active'));
      }
    });
  });
</script>
