---
import Layout from '../../layouts/Layout.astro';
import Icon from '../../components/Icon.astro';
import {
  getAllDomains,
  getDomain,
  getDomainScreens,
  getDomainComponentOverview,
  getDomainPolicies,
  getDomainExperiments,
  POLICY_GROUP_LABELS,
  buildPrompt,
  relTime,
} from '../../lib/repo.js';

export async function getStaticPaths() {
  return getAllDomains().map((d) => ({ params: { domain: d.slug } }));
}

const base = import.meta.env.BASE_URL;
const { domain: slug } = Astro.params;
const domain = getDomain(slug);
if (!domain) return Astro.redirect(base);

const screens = getDomainScreens(slug);
const componentOverview = getDomainComponentOverview(slug);
const usedComponents = componentOverview.used;
const ownedComponents = componentOverview.owned;
const policies = getDomainPolicies(slug);
const experiments = getDomainExperiments(slug);
const expCounts = experiments.reduce((acc, e) => { acc[e.status] = (acc[e.status] || 0) + 1; return acc; }, {});
const policyGroupOrder = ['principles', 'operational', 'exceptions', 'decisions', 'open-questions', 'sources'];
const policySections = policies.flatMap((policy) => (
  (policy.sections || []).map((section, sectionIndex) => ({
    ...section,
    policy,
    modalId: `policy-detail-${policy.slug}-${section.id}-${sectionIndex}`.replace(/[^a-z0-9_-]/gi, '-'),
  }))
));
const policyGroups = policyGroupOrder
  .map((id) => ({
    id,
    label: POLICY_GROUP_LABELS[id] || id,
    sections: policySections.filter((section) => section.category === id),
  }))
  .filter((group) => group.sections.length > 0);
const primaryPolicyGroup = policyGroups[0]?.id || 'principles';
const policyOwners = Array.from(new Set(policies.flatMap((policy) => [policy.policyAuthority, policy.owner]).filter(Boolean)));
const policyTracks = Array.from(new Set(policies.map((policy) => policy.track).filter(Boolean)));
const policyLastVerified = policies.map((policy) => policy.lastVerified).filter(Boolean).sort().at(-1);
const openQuestionCount = policyGroups.find((group) => group.id === 'open-questions')?.sections.length || 0;
const principleCount = policyGroups.find((group) => group.id === 'principles')?.sections.length || 0;
const policyKindLabel = (kind) => ({
  'domain-policy': 'domain policy',
  'track-policy': 'track policy',
  'track-context': 'track context',
}[kind] || kind);
const policySourceLabel = (policy) => (
  policy.source === 'track' ? `track:${policy.track}` : 'domain policy'
);

const screensTyped = screens.map((s, i) => ({ ...s, type: i % 2 === 0 ? 'html' : 'figma' }));
const htmlCount = screensTyped.filter((s) => s.type === 'html').length;
const figmaCount = screensTyped.length - htmlCount;
const typeLabel = (t) => (t === 'figma' ? 'Figma' : 'HTML');

const tabs = [
  { id: 'policies', label: 'Track Design Context', count: policies.length },
  { id: 'experiments', label: 'Experiments', count: experiments.length },
  { id: 'components', label: 'Track Components', count: ownedComponents.length },
  { id: 'screens', label: 'Screens', count: screens.length },
];
---

<Layout title={domain.label}>
  <!-- ============ dhead ============ -->
  <header class="dhead">
    <div class="wrap">
      <h1 class="dhead__title">{domain.label}</h1>
      <div class="dhead__meta">
        <div class="dhead__metacol">
          <span class="dhead__metalabel">Product Design Owner</span>
          <span class={`dhead__metavalue${domain.owner === 'TBD' ? '' : ''}`}>{domain.owner}</span>
        </div>
        {domain.reviewer && (
          <div class="dhead__metacol">
            <span class="dhead__metalabel">Reviewer</span>
            <span class="dhead__metavalue">{domain.reviewer}</span>
          </div>
        )}
        {domain.updated && (
          <div class="dhead__metacol">
            <span class="dhead__metalabel">Last updated</span>
            <span class="dhead__metavalue">{relTime(domain.updated)}</span>
          </div>
        )}
      </div>
    </div>
  </header>

  <!-- ============ dtabs ============ -->
  <nav class="dtabs" aria-label="domain tabs" id="dtabs">
    <div class="wrap dtabs__inner">
      {tabs.map((t) => (
        <a
          class={`dtab${t.id === 'policies' ? ' is-active' : ''}`}
          href={`${base}d/${slug}?tab=${t.id}`}
          data-tab={t.id}
        >
          {t.label} <span class="dtab__count">{t.count}</span>
        </a>
      ))}
    </div>
  </nav>

  <!-- ============ dbody ============ -->
  <section class="dbody">
    <div class="wrap">
      <!-- Screens -->
      <div class="dpanel" data-panel="screens" hidden>
        <div class="sechead">
          <div class="sechead__title">Screens</div>
          <div class="sechead__count">{screens.length} screens{domain.updated ? ` · ${relTime(domain.updated)} 업데이트` : ''}</div>
        </div>
        {screensTyped.length === 0 ? (
          <div class="empty">
            <div class="empty__title">아직 화면이 없습니다</div>
            <div class="empty__hint">이 도메인에 screens/ 산출물을 추가하면 여기 표시됩니다.</div>
          </div>
        ) : (
          <div class="sgrid">
            {screensTyped.map((s) => (
              <a class="scard" href={`${base}d/${slug}/s/${s.slug}`} data-type={s.type}>
                <div class="scard__canvas">
                  <span class={`scard__pill is-${s.type}`}>{typeLabel(s.type)}</span>
                  <div class="scard__phone">
                    {s.thumb ? (
                      <img src={s.thumb} alt={s.label} class="scard__shot" />
                    ) : (
                      <div class="scard__mark">{s.label.slice(0, 1)}</div>
                    )}
                  </div>
                </div>
                <div class="scard__meta">
                  <span class="scard__label">{s.label}</span>
                  <span class="scard__pageid">{s.slug}</span>
                  {s.markers.length > 0 && (
                    <div class="scard__markers">
                      {s.markers.slice(0, 3).map((m) => (
                        <span class={`badge${m.kind === 'missing-ods' ? ' badge--warn' : ''}`}>@{m.kind}:{m.value}</span>
                      ))}
                    </div>
                  )}
                </div>
              </a>
            ))}
          </div>
        )}
      </div>

      <!-- Components -->
      <div class="dpanel" data-panel="components" hidden>
        <div class="sechead">
          <div class="sechead__title">Track Components</div>
          <div class="sechead__count">{ownedComponents.length} owned · {usedComponents.length} in use</div>
        </div>
        {usedComponents.length === 0 && ownedComponents.length === 0 ? (
          <div class="empty">
            <div class="empty__title">화면 전용 컴포넌트가 아직 없습니다</div>
            <div class="empty__hint">도메인 컴포넌트나 track component 문서가 있으면 여기에 표시됩니다.</div>
          </div>
        ) : (
          <div>
            <nav class="component-subtabs" aria-label="component tabs" id="component-subtabs">
              {ownedComponents.length > 0 && (
                <a class="component-subtab is-active" href={`${base}d/${slug}?tab=components&component=owned`} data-component-tab="owned">
                  Owned <span>{ownedComponents.length}</span>
                </a>
              )}
              {usedComponents.length > 0 && (
                <a class={`component-subtab${ownedComponents.length === 0 ? ' is-active' : ''}`} href={`${base}d/${slug}?tab=components&component=used`} data-component-tab="used">
                  In use <span>{usedComponents.length}</span>
                </a>
              )}
            </nav>

            {ownedComponents.length > 0 && (
              <div class="component-subpanel" data-component-panel="owned">
                <p class="component-subpanel__desc">이 도메인이 직접 정의하고 소유한 컴포넌트입니다.</p>
                <div class="lgrid">
                  {ownedComponents.map((c) => (
                    <div class="lcard">
                      <div class="lcard__head">
                        <span class="lcard__title">{c.label}</span>
                        <span class="badge badge--accent">{c.type}</span>
                      </div>
                      {c.summary && <p class="lcard__summary">{c.summary}</p>}
                      {c.updated && <div class="lcard__foot"><span>{relTime(c.updated)}</span></div>}
                    </div>
                  ))}
                </div>
              </div>
            )}

            {usedComponents.length > 0 && (
              <div class="component-subpanel" data-component-panel="used" hidden={ownedComponents.length > 0}>
                <p class="component-subpanel__desc">다른 도메인이 소유하지만, 이 도메인 화면에서 사용 중인 컴포넌트입니다.</p>
                <div class="lgrid">
                  {usedComponents.map((c) => (
                    <div class="lcard">
                      <div class="lcard__head">
                        <span class="lcard__title">{c.label}</span>
                        <span class="badge badge--accent">{c.ownerDomain}</span>
                      </div>
                      {c.summary && <p class="lcard__summary">{c.summary}</p>}
                      <div class="lcard__foot">
                        <span>{c.type}</span>
                        {c.status && <span>{c.status}</span>}
                        {c.sourcePath && <span>{c.sourcePath}</span>}
                      </div>
                    </div>
                  ))}
                </div>
              </div>
            )}
          </div>
        )}
      </div>

      <!-- Policies -->
      <div class="dpanel" data-panel="policies">
        <div class="sechead">
          <div class="sechead__title">Track Design Context</div>
        </div>
        {policies.length === 0 || policySections.length === 0 ? (
          <div class="empty">
            <div class="empty__title">아직 정리된 트랙 디자인 맥락이 없습니다</div>
            <div class="empty__hint">이 트랙을 설계할 때 이해해야 하는 운영 맥락·디자인 원칙·예외 케이스·의사결정 배경이 정리되면 여기에 표시됩니다.</div>
          </div>
        ) : (
          <div class="policy-dashboard">
            <section class="policy-summary" aria-label="track design context summary">
              <div class="policy-summary__main">
                <span class="policy-summary__eyebrow">Context coverage</span>
                <strong>{policyTracks.length > 0 ? policyTracks.join(', ') : domain.label}</strong>
              </div>
              <div class="policy-summary__stats">
                <div>
                  <span>{policies.length}</span>
                  <small>sources</small>
                </div>
                <div>
                  <span>{principleCount}</span>
                  <small>디자인 원칙</small>
                </div>
                <div>
                  <span>{openQuestionCount}</span>
                  <small>확인 필요</small>
                </div>
              </div>
              <div class="policy-summary__meta">
                {policyOwners.length > 0 && <span>Owner: {policyOwners.join(' / ')}</span>}
                {policyLastVerified && <span>Last verified: {policyLastVerified}</span>}
              </div>
            </section>

            <details class="policy-sources">
              <summary>Source documents</summary>
              <div class="policy-source-list">
                {policies.map((policy) => (
                  <div class="policy-source-item">
                    <strong>{policy.label}</strong>
                    <span>{policyKindLabel(policy.policyKind || policy.source)}</span>
                    {policy.sourcePath && <code>{policy.sourcePath}</code>}
                  </div>
                ))}
              </div>
            </details>

            <nav class="policy-subtabs" aria-label="policy section tabs" id="policy-subtabs">
              {policyGroups.map((group) => (
                <a
                  class={`policy-subtab${group.id === primaryPolicyGroup ? ' is-active' : ''}`}
                  href={`${base}d/${slug}?tab=policies&policy=${group.id}`}
                  data-policy-tab={group.id}
                >
                  {group.label} <span>{group.sections.length}</span>
                </a>
              ))}
            </nav>

            {policyGroups.map((group) => (
              <section class="policy-subpanel" data-policy-panel={group.id} hidden={group.id !== primaryPolicyGroup}>
                <div class="policy-grid">
                  {group.sections.map((section) => (
                    <article
                      class={`policy-card policy-card--${group.id}`}
                      tabindex="0"
                      role="button"
                      aria-label={`Open policy detail for ${section.title}`}
                      data-policy-modal-open={section.modalId}
                      data-policy-title={section.title}
                      data-policy-category={section.categoryLabel}
                      data-policy-source={policySourceLabel(section.policy)}
                      data-policy-path={section.policy.sourcePath || ''}
                      data-policy-owner={[section.policy.owner, section.policy.policyAuthority].filter(Boolean).join(' / ')}
                    >
                      <div class="policy-card__head">
                        <div>
                          <span class="policy-card__kicker">{policySourceLabel(section.policy)}</span>
                          <h3>{section.title}</h3>
                        </div>
                        <div class="policy-card__head-right">
                          <span class="badge">{section.categoryLabel}</span>
                          <span class="policy-card__chevron" aria-hidden="true">
                            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                              <polyline points="9 6 15 12 9 18"></polyline>
                            </svg>
                          </span>
                        </div>
                      </div>
                      {section.summary && <p class="policy-card__summary">{section.summary}</p>}
                      <template id={section.modalId}>
                        <div class="prose policy-modal__body" set:html={section.html} />
                      </template>
                      <div class="policy-card__foot">
                        {section.policy.owner && <span>{section.policy.owner}</span>}
                        {section.policy.policyAuthority && <span>{section.policy.policyAuthority}</span>}
                        {section.policy.sourcePath && <span class="policy-doc__path">{section.policy.sourcePath}</span>}
                      </div>
                    </article>
                  ))}
                </div>
              </section>
            ))}
          </div>
        )}
      </div>

      <!-- Experiments -->
      <div class="dpanel" data-panel="experiments" hidden>
        <div class="sechead">
          <div class="sechead__title">Experiments</div>
          <div class="sechead__count">{experiments.length} records</div>
        </div>
        {experiments.length === 0 ? (
          <div class="empty">
            <div class="empty__title">실험 기록이 아직 없습니다</div>
            <div class="empty__hint">A/B · 사용성 테스트 결과를 누적하면 자산이 됩니다.</div>
          </div>
        ) : (
          <>
          <div class="exp-filter" id="exp-filter" role="group" aria-label="실험 상태 필터">
            <button type="button" class="exp-chip is-active" data-exp-filter="all">전체 <span class="exp-chip__n">{experiments.length}</span></button>
            {expCounts.running > 0 && <button type="button" class="exp-chip" data-exp-filter="running">진행 중 <span class="exp-chip__n">{expCounts.running}</span></button>}
            {expCounts.win > 0 && <button type="button" class="exp-chip" data-exp-filter="win">Win <span class="exp-chip__n">{expCounts.win}</span></button>}
            {expCounts.loss > 0 && <button type="button" class="exp-chip" data-exp-filter="loss">Loss <span class="exp-chip__n">{expCounts.loss}</span></button>}
            {expCounts.inconclusive > 0 && <button type="button" class="exp-chip" data-exp-filter="inconclusive">Inconclusive <span class="exp-chip__n">{expCounts.inconclusive}</span></button>}
          </div>
          <div class="exp-grid">
            {experiments.map((e) => (
              <article
                class={`exp-card${e.bodyHtml ? ' exp-card--clickable' : ''}`}
                data-status={e.status}
                data-exp-modal-open={e.bodyHtml ? `expm-${e.slug}` : undefined}
                role={e.bodyHtml ? 'button' : undefined}
                tabindex={e.bodyHtml ? '0' : undefined}
                aria-haspopup={e.bodyHtml ? 'dialog' : undefined}
              >
                <div class="exp-card__head">
                  <span class={`badge ${e.status === 'running' ? 'badge--accent' : e.status === 'win' ? 'badge--success' : e.status === 'loss' ? 'badge--fail' : ''}`}>
                    {e.status === 'running' ? '진행 중' : e.status === 'win' ? 'Win' : e.status === 'loss' ? 'Loss' : 'Inconclusive'}
                  </span>
                  <h3 class="exp-card__title">{e.label}</h3>
                  {e.keyDate && (
                    <span class="exp-card__date">{e.keyDateType === 'launched' ? '런칭' : e.keyDateType === 'started' ? '시작' : e.keyDateType === 'ended' ? '종료' : ''}{e.keyDateType ? ' · ' : ''}{relTime(e.keyDate)}</span>
                  )}
                </div>
                {e.linkedFrom && <div class="exp-card__linked">🔗 주 작업: {e.linkedFrom}</div>}
                {e.summary && <p class="exp-card__summary">{e.summary}</p>}
                {e.resultSummary && (
                  <div class={`exp-card__result exp-card__result--${e.status}`}>
                    <span class="exp-card__result-label">결과</span>
                    <p>{e.resultSummary}</p>
                  </div>
                )}
                {e.insight && (
                  <div class="exp-card__insight">
                    <Icon name="insight" size={16} class="exp-card__insight-icon" />
                    <span>{e.insight}</span>
                  </div>
                )}
                <div class="exp-card__foot">
                  {(e.team || e.owner) && (
                    <span class="exp-card__by">{[e.team, Array.isArray(e.owner) ? e.owner.join(', ') : e.owner].filter(Boolean).join(' · ')}</span>
                  )}
                  <span class="exp-card__sources">
                    {e.sources.xpc && <a href={e.sources.xpc} target="_blank" rel="noopener">XPC</a>}
                    {e.sources.slack && <a href={e.sources.slack} target="_blank" rel="noopener">Slack</a>}
                    {e.sources.notion && <a href={e.sources.notion} target="_blank" rel="noopener">Notion</a>}
                    {e.sources.prd && <a href={e.sources.prd} target="_blank" rel="noopener">PRD</a>}
                    {e.sources.figma && <a href={e.sources.figma} target="_blank" rel="noopener">Figma</a>}
                  </span>
                </div>
                {e.bodyHtml && (
                    <template id={`expm-${e.slug}`}>
                      <header class="experiment-modal__head">
                        <div class="experiment-modal__meta">
                          <span class={`badge ${e.status === 'running' ? 'badge--accent' : e.status === 'win' ? 'badge--success' : e.status === 'loss' ? 'badge--fail' : ''}`}>
                            {e.status === 'running' ? '진행 중' : e.status === 'win' ? 'Win' : e.status === 'loss' ? 'Loss' : 'Inconclusive'}
                          </span>
                          {e.keyDate && <span class="experiment-modal__date">{e.keyDateType === 'launched' ? '런칭' : e.keyDateType === 'started' ? '시작' : e.keyDateType === 'ended' ? '종료' : ''}{e.keyDateType ? ' · ' : ''}{relTime(e.keyDate)}</span>}
                        </div>
                        <h2 class="experiment-modal__title">{e.label}</h2>
                        <div class="experiment-modal__submeta">
                          {(e.team || e.owner) && <span>{[e.team, Array.isArray(e.owner) ? e.owner.join(', ') : e.owner].filter(Boolean).join(' · ')}</span>}
                          {e.period && <span>{e.period}</span>}
                          {e.winner && <span>winner: {e.winner}</span>}
                          {e.variants.length > 0 && <span>variants: {e.variants.join(' / ')}</span>}
                        </div>
                        <div class="experiment-modal__sources">
                          {e.sources.xpc && <a href={e.sources.xpc} target="_blank" rel="noopener">XPC</a>}
                          {e.sources.slack && <a href={e.sources.slack} target="_blank" rel="noopener">Slack</a>}
                          {e.sources.notion && <a href={e.sources.notion} target="_blank" rel="noopener">Notion</a>}
                          {e.sources.prd && <a href={e.sources.prd} target="_blank" rel="noopener">PRD</a>}
                          {e.sources.figma && <a href={e.sources.figma} target="_blank" rel="noopener">Figma</a>}
                        </div>
                      </header>
                      <div class="prose experiment-modal__body" set:html={e.bodyHtml} />
                    </template>
                )}
              </article>
            ))}
          </div>
          </>
        )}
      </div>
    </div>
  </section>

  <div id="policy-modal" class="policy-modal" role="dialog" aria-modal="true" aria-hidden="true" hidden>
    <button type="button" class="policy-modal__backdrop" data-policy-modal-close aria-label="Close policy detail"></button>
    <article class="policy-modal__panel" aria-labelledby="policy-modal-title">
      <header class="policy-modal__head">
        <div class="policy-modal__titleblock">
          <div class="policy-modal__meta">
            <span class="badge" data-policy-modal-category></span>
            <span data-policy-modal-source></span>
          </div>
          <h2 id="policy-modal-title"></h2>
          <div class="policy-modal__submeta">
            <span data-policy-modal-owner></span>
            <code data-policy-modal-path></code>
          </div>
        </div>
        <button type="button" class="policy-modal__close" data-policy-modal-close aria-label="Close policy detail">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
            <line x1="18" y1="6" x2="6" y2="18"></line>
            <line x1="6" y1="6" x2="18" y2="18"></line>
          </svg>
        </button>
      </header>
      <div class="policy-modal__content" data-policy-modal-content></div>
    </article>
  </div>

  <div id="experiment-modal" class="experiment-modal" role="dialog" aria-modal="true" aria-hidden="true" hidden>
    <button type="button" class="experiment-modal__backdrop" data-exp-modal-close aria-label="Close experiment detail"></button>
    <article class="experiment-modal__panel" aria-label="experiment detail">
      <button type="button" class="experiment-modal__close" data-exp-modal-close aria-label="Close experiment detail">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
      </button>
      <div class="experiment-modal__content" data-exp-modal-content></div>
    </article>
  </div>
</Layout>

<script>
  // 정적 빌드 호환: 모든 패널을 렌더하고 ?tab= + 클릭으로 client-side 토글.
  function initTabs() {
    const tabsNav = document.getElementById('dtabs');
    if (!tabsNav || (tabsNav as HTMLElement).dataset.bound) return;
    (tabsNav as HTMLElement).dataset.bound = '1';

    const panels = Array.from(document.querySelectorAll<HTMLElement>('.dpanel'));
    const links = Array.from(tabsNav.querySelectorAll<HTMLElement>('.dtab'));

    function activate(id: string) {
      links.forEach((l) => l.classList.toggle('is-active', l.dataset.tab === id));
      panels.forEach((p) => { p.hidden = p.dataset.panel !== id; });
    }

    const initial = new URLSearchParams(window.location.search).get('tab') || 'policies';
    if (initial !== 'policies') activate(initial);

    tabsNav.addEventListener('click', (e) => {
      const link = (e.target as HTMLElement).closest('.dtab') as HTMLElement | null;
      if (!link) return;
      e.preventDefault();
      const id = link.dataset.tab || 'policies';
      activate(id);
      const url = new URL(window.location.href);
      url.searchParams.set('tab', id);
      window.history.replaceState({}, '', url);
    });
  }
  initTabs();
  document.addEventListener('astro:page-load', initTabs);

  function initComponentTabs() {
    const tabsNav = document.getElementById('component-subtabs');
    if (!tabsNav || (tabsNav as HTMLElement).dataset.bound) return;
    (tabsNav as HTMLElement).dataset.bound = '1';

    const panels = Array.from(document.querySelectorAll<HTMLElement>('.component-subpanel'));
    const links = Array.from(tabsNav.querySelectorAll<HTMLElement>('.component-subtab'));

    function activate(id: string) {
      links.forEach((l) => l.classList.toggle('is-active', l.dataset.componentTab === id));
      panels.forEach((p) => { p.hidden = p.dataset.componentPanel !== id; });
    }

    const initial = new URLSearchParams(window.location.search).get('component') || links[0]?.dataset.componentTab || 'owned';
    activate(initial);

    tabsNav.addEventListener('click', (e) => {
      const link = (e.target as HTMLElement).closest('.component-subtab') as HTMLElement | null;
      if (!link) return;
      e.preventDefault();
      const id = link.dataset.componentTab || 'owned';
      activate(id);
      const url = new URL(window.location.href);
      url.searchParams.set('tab', 'components');
      url.searchParams.set('component', id);
      window.history.replaceState({}, '', url);
    });
  }
  initComponentTabs();
  document.addEventListener('astro:page-load', initComponentTabs);

  function initPolicyTabs() {
    const tabsNav = document.getElementById('policy-subtabs');
    if (!tabsNav || (tabsNav as HTMLElement).dataset.bound) return;
    (tabsNav as HTMLElement).dataset.bound = '1';

    const panels = Array.from(document.querySelectorAll<HTMLElement>('.policy-subpanel'));
    const links = Array.from(tabsNav.querySelectorAll<HTMLElement>('.policy-subtab'));

    function activate(id: string) {
      const fallback = links[0]?.dataset.policyTab || 'principles';
      const next = links.some((link) => link.dataset.policyTab === id) ? id : fallback;
      links.forEach((l) => l.classList.toggle('is-active', l.dataset.policyTab === next));
      panels.forEach((p) => { p.hidden = p.dataset.policyPanel !== next; });
    }

    const initial = new URLSearchParams(window.location.search).get('policy') || links[0]?.dataset.policyTab || 'principles';
    activate(initial);

    tabsNav.addEventListener('click', (e) => {
      const link = (e.target as HTMLElement).closest('.policy-subtab') as HTMLElement | null;
      if (!link) return;
      e.preventDefault();
      const id = link.dataset.policyTab || 'principles';
      activate(id);
      const url = new URL(window.location.href);
      url.searchParams.set('tab', 'policies');
      url.searchParams.set('policy', id);
      window.history.replaceState({}, '', url);
    });
  }
  initPolicyTabs();
  document.addEventListener('astro:page-load', initPolicyTabs);

  function initPolicyModal() {
    const modal = document.getElementById('policy-modal');
    if (!modal || (modal as HTMLElement).dataset.bound) return;
    (modal as HTMLElement).dataset.bound = '1';

    const title = modal.querySelector<HTMLElement>('#policy-modal-title');
    const category = modal.querySelector<HTMLElement>('[data-policy-modal-category]');
    const source = modal.querySelector<HTMLElement>('[data-policy-modal-source]');
    const owner = modal.querySelector<HTMLElement>('[data-policy-modal-owner]');
    const path = modal.querySelector<HTMLElement>('[data-policy-modal-path]');
    const content = modal.querySelector<HTMLElement>('[data-policy-modal-content]');
    const closeButtons = Array.from(modal.querySelectorAll<HTMLElement>('[data-policy-modal-close]'));

    function setText(el: HTMLElement | null, value: string | null) {
      if (!el) return;
      el.textContent = value || '';
      el.hidden = !value;
    }

    function closeModal() {
      modal.hidden = true;
      modal.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
      if (content) content.innerHTML = '';
    }

    function openModal(button: HTMLElement) {
      const templateId = button.dataset.policyModalOpen || '';
      const template = document.getElementById(templateId) as HTMLTemplateElement | null;
      if (!template || !content) return;

      setText(title, button.dataset.policyTitle || 'Policy detail');
      setText(category, button.dataset.policyCategory || '');
      setText(source, button.dataset.policySource || '');
      setText(owner, button.dataset.policyOwner || '');
      setText(path, button.dataset.policyPath || '');
      content.innerHTML = template.innerHTML;
      modal.hidden = false;
      modal.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
      modal.querySelector<HTMLElement>('[data-policy-modal-close]')?.focus();
    }

    document.addEventListener('click', (event) => {
      const trigger = (event.target as HTMLElement).closest('[data-policy-modal-open]') as HTMLElement | null;
      if (!trigger) return;
      event.preventDefault();
      openModal(trigger);
    });

    document.addEventListener('keydown', (event) => {
      const target = event.target as HTMLElement | null;
      if (!target?.closest('[data-policy-modal-open]')) return;
      if (event.key !== 'Enter' && event.key !== ' ') return;
      event.preventDefault();
      openModal(target.closest('[data-policy-modal-open]') as HTMLElement);
    });

    closeButtons.forEach((button) => button.addEventListener('click', closeModal));
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && !modal.hidden) closeModal();
    });
  }
  initPolicyModal();
  document.addEventListener('astro:page-load', initPolicyModal);

  function initExperimentModal() {
    const modal = document.getElementById('experiment-modal');
    if (!modal || (modal as HTMLElement).dataset.bound) return;
    (modal as HTMLElement).dataset.bound = '1';
    const content = modal.querySelector<HTMLElement>('[data-exp-modal-content]');
    function close() {
      (modal as HTMLElement).hidden = true;
      modal.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
      if (content) content.innerHTML = '';
    }
    function openFromTrigger(trigger: HTMLElement) {
      const tpl = document.getElementById(trigger.dataset.expModalOpen || '') as HTMLTemplateElement | null;
      if (!tpl || !content) return;
      content.innerHTML = tpl.innerHTML;
      (modal as HTMLElement).hidden = false;
      modal.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
      modal.querySelector<HTMLElement>('[data-exp-modal-close]')?.focus();
    }
    document.addEventListener('click', (event) => {
      // 출처 링크(<a> XPC~Figma 등) 클릭은 그대로 이동 — 카드 모달 열지 않음
      if ((event.target as HTMLElement).closest('a')) return;
      const trigger = (event.target as HTMLElement).closest<HTMLElement>('[data-exp-modal-open]');
      if (trigger) { event.preventDefault(); openFromTrigger(trigger); return; }
      if ((event.target as HTMLElement).closest('[data-exp-modal-close]')) close();
    });
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && !(modal as HTMLElement).hidden) { close(); return; }
      if ((event.key === 'Enter' || event.key === ' ') && !(event.target as HTMLElement).closest('a')) {
        const trigger = (event.target as HTMLElement).closest<HTMLElement>('[data-exp-modal-open]');
        if (trigger) { event.preventDefault(); openFromTrigger(trigger); }
      }
    });
  }
  initExperimentModal();
  document.addEventListener('astro:page-load', initExperimentModal);

  function initExperimentFilter() {
    const bar = document.getElementById('exp-filter');
    if (!bar || (bar as HTMLElement).dataset.bound) return;
    (bar as HTMLElement).dataset.bound = '1';
    const chips = Array.from(bar.querySelectorAll<HTMLElement>('.exp-chip'));
    const cards = Array.from(document.querySelectorAll<HTMLElement>('.exp-card'));
    bar.addEventListener('click', (event) => {
      const chip = (event.target as HTMLElement).closest<HTMLElement>('.exp-chip');
      if (!chip) return;
      const value = chip.dataset.expFilter || 'all';
      chips.forEach((c) => c.classList.toggle('is-active', c === chip));
      cards.forEach((card) => { card.hidden = !(value === 'all' || card.dataset.status === value); });
    });
  }
  initExperimentFilter();
  document.addEventListener('astro:page-load', initExperimentFilter);
</script>

