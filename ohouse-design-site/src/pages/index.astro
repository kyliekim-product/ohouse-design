---
import Layout from '../layouts/Layout.astro';
import FilterBar from '../components/FilterBar.astro';
import ReferenceCard from '../components/ReferenceCard.astro';
import { DISCOVERY_AXES, getAllBrowseCards, getOverlayGroups } from '../lib/repo.js';

const base = import.meta.env.BASE_URL;

const axes = DISCOVERY_AXES.map((axis) => {
  const groups = getOverlayGroups(axis.id);
  const labelMap = new Map(groups.flatMap((group) => group.items.map((item) => [item.slug, item.label])));

  return {
    ...axis,
    href: `${base}${axis.href}`,
    featuredLabels: axis.featured.map((slug) => labelMap.get(slug) || slug),
  };
});

const recommended = getAllBrowseCards('screens')
  .slice()
  .sort((a, b) => {
    const aTime = a.updated ? new Date(a.updated).getTime() : 0;
    const bTime = b.updated ? new Date(b.updated).getTime() : 0;
    return bTime - aTime;
  })
  .slice(0, 12);
---

<Layout title="Ohouse Design">
  <main class="wrap home home-v2" data-home-filter-root>
    <section class="home-hero">
      <div>
        <span class="home-hero__eyebrow">Ohouse Design Reference</span>
        <h1>Find screens, elements, flows, and domains in one place.</h1>
      </div>
      <p>도메인 조직도가 아니라 실제 디자인 탐색 방식에 맞춰 화면 패턴, UI 요소, 플로우, 카테고리를 함께 탐색합니다.</p>
    </section>

    <section class="axis-grid" aria-label="Browse axes">
      {axes.map((axis) => (
        <a class="axis-card" href={axis.href}>
          <span class="axis-card__label">{axis.label}</span>
          <strong>{axis.summary}</strong>
          <div class="axis-card__links">
            {axis.featuredLabels.map((item) => <span>{item}</span>)}
          </div>
        </a>
      ))}
    </section>

    <FilterBar sort="latest" />

    <section class="home-section">
      <div class="sechead">
        <div class="sechead__title">Recently updated references</div>
        <div class="sechead__count" data-home-results-count>{recommended.length} items</div>
      </div>
      <div class="ref-grid" data-home-results>
        {recommended.map((item) => <ReferenceCard item={item} />)}
      </div>
    </section>
  </main>
</Layout>

<script>
  function initHomeIA() {
    const root = document.querySelector('[data-home-filter-root]') as HTMLElement | null;
    if (!root || root.dataset.bound) return;
    root.dataset.bound = '1';

    const results = root.querySelector('[data-home-results]') as HTMLElement | null;
    const count = root.querySelector('[data-home-results-count]') as HTMLElement | null;
    if (!results) return;

    const cards = Array.from(results.querySelectorAll<HTMLElement>('[data-reference-card]')).map((card, index) => ({
      card,
      index,
      updated: Date.parse(card.dataset.updated || '') || 0,
    }));

    const state = {
      os: 'all',
      source: 'all',
      status: 'all',
      sort: 'latest',
    };

    function matches(card: HTMLElement) {
      if (state.os !== 'all' && card.dataset.os !== state.os) return false;
      if (state.source !== 'all' && card.dataset.source !== state.source) return false;
      if (state.status !== 'all' && card.dataset.status !== state.status) return false;
      return true;
    }

    function compare(a: { index: number; updated: number }, b: { index: number; updated: number }) {
      if (state.sort === 'updated') return b.updated - a.updated || a.index - b.index;
      return a.index - b.index;
    }

    function render() {
      const visible = cards.filter(({ card }) => matches(card)).sort(compare);
      visible.forEach(({ card }) => {
        card.hidden = false;
        results.appendChild(card);
      });
      cards
        .filter(({ card }) => !matches(card))
        .forEach(({ card }) => {
          card.hidden = true;
        });

      if (count) count.textContent = `${visible.length} items`;
    }

    root.querySelector('.fbar__platform')?.addEventListener('click', (event) => {
      const button = (event.target as HTMLElement).closest<HTMLElement>('[data-filter-key="os"]');
      if (!button) return;

      state.os = button.dataset.filterValue || 'all';
      root.querySelectorAll<HTMLElement>('[data-filter-key="os"]').forEach((item) => {
        item.classList.toggle('is-active', item === button);
      });
      render();
    });

    root.querySelectorAll<HTMLSelectElement>('.fbar__select').forEach((select) => {
      select.addEventListener('change', () => {
        const key = select.dataset.filterKey;
        if (key === 'source' || key === 'status') {
          state[key] = select.value;
        }
        render();
      });
    });

    root.querySelector('.fbar__sort')?.addEventListener('click', (event) => {
      const button = (event.target as HTMLElement).closest<HTMLElement>('[data-sort]');
      if (!button) return;

      state.sort = button.dataset.sort || 'latest';
      root.querySelectorAll<HTMLElement>('[data-sort]').forEach((item) => {
        item.classList.toggle('is-active', item === button);
      });
      render();
    });

    render();
  }

  initHomeIA();
  document.addEventListener('astro:page-load', initHomeIA);
</script>
