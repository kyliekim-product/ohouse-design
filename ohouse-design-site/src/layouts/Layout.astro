---
import '../styles/global.css';
import Nav from '../components/Nav.astro';

const { title = '오늘의집 디자인', description = 'PD 의 화면 작업 베이스 — 도메인 18개 × screens · components · policies · experiments' } = Astro.props;
const fullTitle = title === '오늘의집 디자인' ? title : `${title} · 오늘의집 디자인`;
const base = import.meta.env.BASE_URL;
---

<!DOCTYPE html>
<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
  </head>
  <body>
    <Nav />
    <slot />
    <div id="toast" class="toast">복사됨</div>

    <!-- ─── 공용 라이트박스 (data-lightbox-src 트리거) ─── -->
    <div id="lightbox" class="lightbox" aria-hidden="true" role="dialog" aria-modal="true" aria-label="이미지 확대">
      <button type="button" class="lightbox__close" aria-label="닫기">
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
        </svg>
      </button>
      <figure class="lightbox__figure">
        <img id="lightbox-img" alt="" />
        <figcaption id="lightbox-cap" class="lightbox__cap"></figcaption>
      </figure>
    </div>

    <script>
      // ─── Copy prompt 클립보드 핸들러 ───
      const toast = document.getElementById('toast');
      let toastTimer: number | null = null;

      function showToast(msg = '복사됨') {
        if (!toast) return;
        toast.textContent = msg;
        toast.classList.add('show');
        if (toastTimer) clearTimeout(toastTimer);
        toastTimer = window.setTimeout(() => toast.classList.remove('show'), 1800);
      }

      // ─── 라이트박스 ───
      const lb = document.getElementById('lightbox');
      const lbImg = document.getElementById('lightbox-img') as HTMLImageElement | null;
      const lbCap = document.getElementById('lightbox-cap');
      const lbClose = lb?.querySelector('.lightbox__close');

      function openLightbox(src: string, caption = '') {
        if (!lb || !lbImg) return;
        lbImg.src = src;
        lbImg.alt = caption;
        if (lbCap) lbCap.textContent = caption;
        lb.classList.add('is-open');
        lb.setAttribute('aria-hidden', 'false');
        document.body.style.overflow = 'hidden';
      }
      function closeLightbox() {
        if (!lb || !lbImg) return;
        lb.classList.remove('is-open');
        lb.setAttribute('aria-hidden', 'true');
        document.body.style.overflow = '';
        // src 비워서 큰 이미지 메모리 해제
        window.setTimeout(() => { if (!lb.classList.contains('is-open')) lbImg.src = ''; }, 200);
      }
      lbClose?.addEventListener('click', closeLightbox);
      lb?.addEventListener('click', (e) => {
        if (e.target === lb) closeLightbox();
      });
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && lb?.classList.contains('is-open')) closeLightbox();
      });

      function bindCloseOnOutside() {
        const doc = document.documentElement;
        if (doc.dataset.closeDropdowns) return;
        doc.dataset.closeDropdowns = '1';

        document.addEventListener('click', (event) => {
          const target = event.target as Node | null;
          document.querySelectorAll<HTMLDetailsElement>('details[data-close-on-outside][open]').forEach((details) => {
            if (target && details.contains(target)) return;
            details.removeAttribute('open');
          });
        });

        document.addEventListener('keydown', (event) => {
          if (event.key !== 'Escape') return;
          document.querySelectorAll<HTMLDetailsElement>('details[data-close-on-outside][open]').forEach((details) => {
            details.removeAttribute('open');
          });
        });
      }

      function bind() {
        bindCloseOnOutside();

        // Copy prompt
        document.querySelectorAll<HTMLElement>('[data-copy-prompt]').forEach((btn) => {
          if (btn.dataset.bound) return;
          btn.dataset.bound = '1';
          btn.addEventListener('click', async (e) => {
            e.preventDefault();
            e.stopPropagation();
            const text = btn.getAttribute('data-copy-prompt') || '';
            try {
              await navigator.clipboard.writeText(text);
              showToast('Prompt 복사됨 · Claude/ChatGPT 에 붙여넣으세요');
            } catch {
              showToast('복사 실패 — 브라우저 권한 확인');
            }
          });
        });
        // Lightbox 트리거
        document.querySelectorAll<HTMLElement>('[data-lightbox-src]').forEach((el) => {
          if (el.dataset.lbBound) return;
          el.dataset.lbBound = '1';
          el.addEventListener('click', (e) => {
            e.preventDefault();
            const src = el.getAttribute('data-lightbox-src') || '';
            const cap = el.getAttribute('data-lightbox-caption') || '';
            if (src) openLightbox(src, cap);
          });
        });
      }
      bind();
      // Astro view transitions 대비
      document.addEventListener('astro:page-load', bind);
    </script>
  </body>
</html>
