---
// 필터 row — 디자인 소스(preview-home.html) 기준.
// 좌: [All | HTML | Figma] type 토글  (홈 JS 가 #typeToggle 로 grid[data-filter] 제어)
// 가운데: 정렬 탭 (Latest · Recently updated · Most viewed · All)
// 우: ≡ Filter
// 스타일은 global.css 의 .fbar* 이 소유.
const { sort = 'latest' } = Astro.props;

const types = [
  { value: 'all', label: 'All' },
  { value: 'html', label: 'HTML' },
  { value: 'figma', label: 'Figma' },
];

const sorts = [
  { value: 'latest', label: 'Latest' },
  { value: 'updated', label: 'Recently updated' },
  { value: 'popular', label: 'Most viewed' },
  { value: 'all', label: 'All' },
];
---

<div class="fbar">
  <div class="fbar__platform" id="typeToggle">
    {types.map((t) => (
      <button type="button" class={`fbar__pf${t.value === 'all' ? ' is-active' : ''}`} data-type={t.value}>
        {t.label}
      </button>
    ))}
  </div>

  <div class="fbar__sort">
    {sorts.map((s) => (
      <button type="button" class={`fbar__sort-item${s.value === sort ? ' is-active' : ''}`} data-sort={s.value}>
        {s.label}
      </button>
    ))}
  </div>

  <button type="button" class="fbar__filter" aria-label="필터">
    <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <line x1="4" y1="6" x2="20" y2="6"/>
      <line x1="7" y1="12" x2="17" y2="12"/>
      <line x1="10" y1="18" x2="14" y2="18"/>
    </svg>
    <span>Filter</span>
  </button>
</div>
