---
import { OS_OPTIONS, SOURCE_OPTIONS, STATUS_OPTIONS } from '../lib/repo.js';
import Icon from './Icon.astro';

const { sort = 'latest' } = Astro.props;

const osOptions = [{ value: 'all', label: 'All OS' }, ...OS_OPTIONS];
const sourceOptions = SOURCE_OPTIONS;
const statusOptions = STATUS_OPTIONS;

const sorts = [
  { value: 'latest', label: 'Latest' },
  { value: 'updated', label: 'Recently updated' },
];
const activeSort = sorts.find((s) => s.value === sort) || sorts[0];
---

<div class="fbar">
  <div class="fbar__platform" id="osToggle" aria-label="OS filter">
    {osOptions.map((t) => (
      <button type="button" class={`fbar__pf${t.value === 'all' ? ' is-active' : ''}`} data-filter-key="os" data-filter-value={t.value}>
        {t.label}
      </button>
    ))}
  </div>

  <details class="fbar__sortbox" data-close-on-outside>
    <summary class="fbar__sort-trigger">
      <span data-sort-label>{activeSort.label}</span>
      <Icon name="chevron-down" size={15} />
    </summary>
    <div class="fbar__sort-panel">
      {sorts.map((s) => (
        <button type="button" class={`fbar__sort-option${s.value === activeSort.value ? ' is-active' : ''}`} data-sort={s.value}>
          {s.label}
        </button>
      ))}
    </div>
  </details>

  <details class="fbar__filterbox" data-close-on-outside>
    <summary class="fbar__filter">
      <span>Filter</span>
      <Icon name="chevron-down" size={15} />
    </summary>
    <div class="fbar__filter-panel">
      <fieldset class="fbar__filter-group">
        <legend>Sources</legend>
        {sourceOptions.map((t) => (
          <label class="fbar__check">
            <input type="checkbox" data-filter-key="source" data-filter-value={t.value} />
            <span>{t.label}</span>
          </label>
        ))}
      </fieldset>
      <fieldset class="fbar__filter-group">
        <legend>Status</legend>
        {statusOptions.map((t) => (
          <label class="fbar__check">
            <input type="checkbox" data-filter-key="status" data-filter-value={t.value} />
            <span>{t.label}</span>
          </label>
        ))}
      </fieldset>
    </div>
  </details>
</div>
