---
const { name, size = 16, class: className = '' } = Astro.props;
const attrs = {
  class: `icon ${className}`.trim(),
  width: size,
  height: size,
  viewBox: '0 0 24 24',
  fill: 'none',
  stroke: 'currentColor',
  'stroke-width': '2',
  'stroke-linecap': 'round',
  'stroke-linejoin': 'round',
  'aria-hidden': 'true',
};
---

{name === 'chevron-down' && (
  <svg {...attrs}>
    <path d="m6 9 6 6 6-6" />
  </svg>
)}

{name === 'arrow-up-right' && (
  <svg {...attrs}>
    <path d="M7 17 17 7" />
    <path d="M7 7h10v10" />
  </svg>
)}

{name === 'arrow-right' && (
  <svg {...attrs}>
    <path d="M5 12h14" />
    <path d="m12 5 7 7-7 7" />
  </svg>
)}

{name === 'sort' && (
  <svg {...attrs}>
    <path d="M7 7h10" />
    <path d="M7 12h7" />
    <path d="M7 17h4" />
  </svg>
)}

{name === 'filter' && (
  <svg {...attrs}>
    <path d="M4 5h16" />
    <path d="M7 12h10" />
    <path d="M10 19h4" />
  </svg>
)}

{name === 'insight' && (
  <svg {...attrs} fill="currentColor" stroke="none">
    <path d="M9 21c0 .55.45 1 1 1h4c.55 0 1-.45 1-1v-1H9v1zm3-19C8.14 2 5 5.14 5 9c0 2.38 1.19 4.47 3 5.74V17c0 .55.45 1 1 1h6c.55 0 1-.45 1-1v-2.26c1.81-1.27 3-3.36 3-5.74 0-3.86-3.14-7-7-7z" />
  </svg>
)}
