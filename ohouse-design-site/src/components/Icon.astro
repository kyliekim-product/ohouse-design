---
const { name, size = 16, class: className = '' } = Astro.props;
const attrs = {
  class: `icon ${className}`.trim(),
  width: size,
  height: size,
  viewBox: '0 0 24 24',
  fill: 'none',
  stroke: 'currentColor',
  'stroke-width': '2',
  'stroke-linecap': 'round',
  'stroke-linejoin': 'round',
  'aria-hidden': 'true',
};
---

{name === 'chevron-down' && (
  <svg {...attrs}>
    <path d="m6 9 6 6 6-6" />
  </svg>
)}

{name === 'arrow-up-right' && (
  <svg {...attrs}>
    <path d="M7 17 17 7" />
    <path d="M7 7h10v10" />
  </svg>
)}

{name === 'arrow-right' && (
  <svg {...attrs}>
    <path d="M5 12h14" />
    <path d="m12 5 7 7-7 7" />
  </svg>
)}

{name === 'sort' && (
  <svg {...attrs}>
    <path d="M7 7h10" />
    <path d="M7 12h7" />
    <path d="M7 17h4" />
  </svg>
)}

{name === 'filter' && (
  <svg {...attrs}>
    <path d="M4 5h16" />
    <path d="M7 12h10" />
    <path d="M10 19h4" />
  </svg>
)}

{name === 'insight' && (
  <svg {...attrs}>
    <path d="M9 18h6" />
    <path d="M10 22h4" />
    <path d="M15.09 14c.18-.98.65-1.74 1.41-2.5A4.65 4.65 0 0 0 18 8 6 6 0 0 0 6 8c0 1 .23 2.23 1.5 3.5.76.76 1.23 1.52 1.41 2.5" />
  </svg>
)}
