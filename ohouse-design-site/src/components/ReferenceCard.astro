---
const { item } = Astro.props;
const osLabel = String(item.os || '')
  .replace('mobile-web', 'Mobile Web')
  .replace('ios', 'iOS')
  .replace('android', 'Android')
  .replace('web', 'Web');
const sourceLabel = String(item.source || '').toUpperCase();
const identity = [item.domain, item.pattern].filter(Boolean).join(' · ');
const taxonomy = [item.domain, item.pattern, item.element, item.flow].filter(Boolean);
---

<a
  class="ref-card"
  href={item.href}
  data-reference-card
  data-os={item.os || ''}
  data-source={item.source || ''}
  data-status={item.status || ''}
  data-updated={item.updated || ''}
>
  <div class="ref-card__canvas">
    {sourceLabel && <span class="ref-card__pill">{sourceLabel}</span>}
    <div class="ref-card__phone">
      {item.thumb ? (
        <img class="ref-card__shot" src={item.thumb} alt={item.label} loading="lazy" />
      ) : (
        <div class="ref-card__placeholder" aria-hidden="true">
          <span>{item.domain?.slice(0, 1) || item.label.slice(0, 1)}</span>
        </div>
      )}
    </div>
  </div>

  <div class="ref-card__body">
    <div class="ref-card__identity">
      <div>
        <h3>{item.label}</h3>
        {identity && <p>{identity}</p>}
      </div>
      <div class="ref-card__state">
        {osLabel && <span>{osLabel}</span>}
        {item.status && <span>{item.status}</span>}
      </div>
    </div>
    <div class="ref-card__taxonomy">
      {taxonomy.map((value) => <span>{value}</span>)}
    </div>
  </div>
</a>
