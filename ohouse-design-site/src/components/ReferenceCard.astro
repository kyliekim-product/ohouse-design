---
const { item } = Astro.props;
const osLabels = Array.isArray(item.os)
  ? item.os.map((value) => String(value))
  : String(item.os || '').split(',');
const displayOsLabels = osLabels
  .map((value) => value.trim())
  .filter(Boolean)
  .map((value) => value
    .replace('mobile-web', 'Mobile Web')
    .replace('ios', 'iOS')
    .replace('android', 'Android')
    .replace('web', 'Web'));
const identityBadges = [item.domain, item.pattern].filter(Boolean);
---

<a
  class="ref-card"
  href={item.href}
  data-reference-card
  data-os={item.os || ''}
  data-source={item.source || ''}
  data-status={item.status || ''}
  data-updated={item.updated || ''}
  data-domain-slug={item.domainSlug || ''}
>
  <div class="ref-card__canvas">
    {displayOsLabels.length > 0 && (
      <div class="ref-card__pills" aria-label="OS">
        {displayOsLabels.map((label) => <span class="ref-card__pill">{label}</span>)}
      </div>
    )}
    <div class="ref-card__phone">
      {item.thumb ? (
        <img class="ref-card__shot" src={item.thumb} alt={item.label} loading="lazy" />
      ) : (
        <div class="ref-card__placeholder" aria-hidden="true">
          <span>{item.domain?.slice(0, 1) || item.label.slice(0, 1)}</span>
        </div>
      )}
    </div>
  </div>

  <div class="ref-card__body">
    <div class="ref-card__identity">
      <div>
        <h3>{item.label}</h3>
        <div class="ref-card__identity-badges">
          {identityBadges.map((value) => <span>{value}</span>)}
        </div>
      </div>
    </div>
  </div>
</a>
