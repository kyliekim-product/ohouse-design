---
import { DISCOVERY_AXES, getOverlayGroups } from '../lib/repo.js';

const base = import.meta.env.BASE_URL;
const path = Astro.url.pathname;

// base 를 제거한 경로로 match (sub-path 빌드에서도 활성 탭 판정 정확하게).
const rel = '/' + path.replace(base, '').replace(/^\/+/, '');

const axes = DISCOVERY_AXES.map((axis) => ({
  ...axis,
  href: `${base}${axis.href}`,
  active: rel === `/${axis.href}` || rel.startsWith(`/${axis.href}/`),
  groups: getOverlayGroups(axis.id),
}));
const activeAxis = axes.find((axis) => axis.active) || axes[0];
const designSystemActive = rel.startsWith('/ods');
const designActive =
  !designSystemActive &&
  (rel === '/' ||
    rel.startsWith('/d/') ||
    rel.startsWith('/categories') ||
    rel.startsWith('/screens') ||
    rel.startsWith('/ui-elements') ||
    rel.startsWith('/flows') ||
    rel.startsWith('/knowledge') ||
    rel.startsWith('/mcp') ||
    rel.startsWith('/asset') ||
    rel.startsWith('/vision'));
---

<header class="nav-root">
  <div class="nav-inner">
    <div class="nav-left">
      <a href={base} class="brand" aria-label="오늘의집">
        <img src={`${base}ohouse-3d.png`} alt="" class="brand__logo" width="32" height="32" />
      </a>
      <nav class="nav-tabs" aria-label="Ohouse Design browse axes">
        <div class="nav-axis" data-axis-root>
          <a href={base} class={`nav-tab${designActive ? ' is-active' : ''}`} data-axis-trigger>
            Ohouse Design
          </a>
          <div class="nav-overlay" data-axis-overlay hidden>
            <div class="nav-overlay__rail">
              <div class="nav-overlay__eyebrow">Browse</div>
              {axes.map((item) => (
                <button
                  type="button"
                  class={`nav-overlay__rail-item${item.id === activeAxis.id ? ' is-active' : ''}`}
                  data-axis-option={item.id}
                >
                  {item.label}
                </button>
              ))}
            </div>
            <div class="nav-overlay__body">
              {axes.map((axis) => (
                <div class="nav-overlay__panel" data-axis-panel={axis.id} hidden={axis.id !== activeAxis.id}>
                  <div class="nav-overlay__head">
                    <strong>{axis.label}</strong>
                    <span>{axis.summary}</span>
                  </div>
                  <div class="nav-overlay__groups">
                    {axis.groups.map((group) => (
                      <section class="nav-overlay__group">
                        <h3>{group.group}</h3>
                        {group.items.map((item) => (
                          <a class="nav-overlay__item" href={item.href}>
                            <span>{item.label}</span>
                            <span>{item.count}</span>
                          </a>
                        ))}
                      </section>
                    ))}
                  </div>
                </div>
              ))}
            </div>
          </div>
        </div>
        <a href={`${base}ods`} class={`nav-tab nav-tab--system${designSystemActive ? ' is-active' : ''}`}>
          Design system
        </a>
      </nav>
    </div>

    <div class="nav-search">
      <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <circle cx="11" cy="11" r="7"/><line x1="21" y1="21" x2="16.65" y2="16.65"/>
      </svg>
      <input type="text" placeholder="Search Ohouse Design..." aria-label="검색" />
      <span class="nav-search__kbd">⌘K</span>
    </div>

    <div class="nav-right">
      <button class="nav-icon" aria-label="북마크">
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"/>
        </svg>
      </button>
      <a class="nav-github" href="https://github.com/bucketplace/product-design" target="_blank" rel="noopener">
        GitHub
      </a>
      <div class="nav-avatar" aria-label="요한" title="요한">요</div>
    </div>
  </div>
  <script>
    function initAxisOverlay() {
      document.querySelectorAll<HTMLElement>('[data-axis-root]').forEach((root) => {
        if (root.dataset.bound) return;
        root.dataset.bound = '1';
        const trigger = root.querySelector<HTMLElement>('[data-axis-trigger]');
        const overlay = root.querySelector<HTMLElement>('[data-axis-overlay]');
        if (!trigger || !overlay) return;
        const options = Array.from(root.querySelectorAll<HTMLElement>('[data-axis-option]'));
        const panels = Array.from(root.querySelectorAll<HTMLElement>('[data-axis-panel]'));
        let closeTimer: number | null = null;
        function open() {
          if (closeTimer) window.clearTimeout(closeTimer);
          overlay.hidden = false;
        }
        function closeSoon() {
          closeTimer = window.setTimeout(() => { overlay.hidden = true; }, 120);
        }
        function activateAxis(id: string) {
          options.forEach((option) => {
            option.classList.toggle('is-active', option.dataset.axisOption === id);
          });
          panels.forEach((panel) => {
            panel.hidden = panel.dataset.axisPanel !== id;
          });
        }
        root.addEventListener('mouseenter', open);
        root.addEventListener('mouseleave', closeSoon);
        trigger.addEventListener('focus', open);
        options.forEach((option) => {
          option.addEventListener('click', () => {
            activateAxis(option.dataset.axisOption || '');
            open();
          });
          option.addEventListener('focus', open);
        });
        root.addEventListener('focusout', (e) => {
          if (!root.contains(e.relatedTarget as Node | null)) overlay.hidden = true;
        });
        root.addEventListener('keydown', (e) => {
          if (e.key === 'Escape') overlay.hidden = true;
        });
      });
    }
    initAxisOverlay();
    document.addEventListener('astro:page-load', initAxisOverlay);
  </script>
</header>
