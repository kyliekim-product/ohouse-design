---
const base = import.meta.env.BASE_URL;
const { screen, domain, compact = false, prompt = '' } = Astro.props;
---

<div class={`sthumb${compact ? ' sthumb--compact' : ''}`}>
  <a class="sthumb__link" href={`${base}d/${domain}/s/${screen.slug}`} aria-label={`${screen.label} 화면 상세`}>
    {screen.thumb ? (
      <img src={screen.thumb} alt={screen.label} loading="lazy" />
    ) : (
      <div class="sthumb__placeholder" aria-hidden="true">
        <span>{screen.label}</span>
      </div>
    )}
  </a>
  {prompt && (
    <button
      type="button"
      class="sthumb__copy"
      data-copy-prompt={prompt}
      aria-label={`${screen.label} prompt 복사`}
      title="Copy prompt"
    >
      <svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
        <rect x="4" y="4" width="9" height="9" rx="1.5" />
        <path d="M3 11V3.5A1.5 1.5 0 0 1 4.5 2H11" />
      </svg>
    </button>
  )}
</div>

<style>
  .sthumb {
    position: relative;
    aspect-ratio: 9 / 16;
    background: var(--c-bg-elev);
    border-radius: var(--r-md);
    overflow: hidden;
    border: 1px solid var(--c-border);
  }
  .sthumb__link {
    display: block; width: 100%; height: 100%;
  }
  .sthumb img {
    width: 100%; height: 100%;
    object-fit: cover;
    transition: transform .3s ease;
  }
  .sthumb:hover img { transform: scale(1.04); }
  .sthumb__placeholder {
    width: 100%; height: 100%;
    display: flex; align-items: center; justify-content: center;
    padding: 8px;
    color: var(--c-text-soft);
    font-size: 11px; font-weight: 500; text-align: center;
    background: linear-gradient(135deg, var(--c-bg-soft), var(--c-bg-elev));
  }
  .sthumb__copy {
    position: absolute; top: 6px; right: 6px;
    width: 26px; height: 26px;
    display: inline-flex; align-items: center; justify-content: center;
    background: rgba(28,25,23,.78);
    color: #fafaf9;
    border-radius: 7px;
    opacity: 0;
    transition: opacity .15s ease, background .15s ease, transform .1s ease;
  }
  .sthumb:hover .sthumb__copy { opacity: 1; }
  .sthumb__copy:hover { background: var(--c-accent); }
  .sthumb__copy:active { transform: scale(0.92); }
</style>
