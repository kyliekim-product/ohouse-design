# ─── Playground API ────────────────────────────────────────────────
# 팀 공용 Key 모드 (beta 기간에는 비워도 됨 — 개인 Key는 UI에서 입력)
# ANTHROPIC_API_KEY=sk-ant-...

# 사용 모델 (기본: claude-sonnet-4-6)
# ANTHROPIC_MODEL=claude-sonnet-4-6

# ─── 사이트 호스팅 ─────────────────────────────────────────────────
# SITE_BASE=/           # sub-path 배포 시 설정 (예: /design)
# PAGES_SITE=https://ohouse-design.example.com
